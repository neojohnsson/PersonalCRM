# Copy this file to .env.local and fill in the values.
# .env.local is gitignored. This file is committed — never put real secrets here.
#
# Rule to remember: NEXT_PUBLIC_ means the value is compiled into the browser
# bundle and is readable by anyone who opens devtools. Everything without that
# prefix stays on the server. Getting this wrong is the most common way people
# leak keys in a Next.js project.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Supabase replaced the legacy `anon` / `service_role` JWT keys with publishable
# (sb_publishable_...) and secret (sb_secret_...) keys. Same privileges, but each
# one can be named and revoked on its own instead of being tied to the project's
# JWT secret. A new project gets the new keys -- use those.
#
# Safe in the browser: the publishable key is designed to be public and is
# useless without row-level security policies. Which means your RLS policies ARE
# your security. Write them first, test them, don't skip them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. This key bypasses every row-level security policy you wrote.
# Never prefix it with NEXT_PUBLIC_. Never import it into a client component.
# If it leaks, every user's contacts leak with it.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Google OAuth (Gmail)
# ---------------------------------------------------------------------------
# From the Google Cloud console, APIs & Services > Credentials.
# The redirect URI must match what's registered there exactly, including the
# trailing path and the port. A mismatch is the #1 OAuth error.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# No GOOGLE_REDIRECT_URI: the callback address is built from whatever address
# the app runs on (lib/google/redirect.ts). Each address still has to be listed
# under Authorised redirect URIs in Google Cloud — localhost, each preview
# branch, and production.

# ---------------------------------------------------------------------------
# Token encryption
# ---------------------------------------------------------------------------
# Gmail refresh tokens are stored in the database. A refresh token is a
# long-lived key to someone's mailbox, so encrypt it at rest rather than
# storing it in plain text.
# Generate with:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
# OpenAI (slice-4-plan.md, decision A). Server only: never NEXT_PUBLIC_, and
# lib/ai/config.ts is "server-only" so a client component can't import it.
# Also set a low monthly limit in OpenAI's own dashboard, as a second fence.
OPENAI_API_KEY=

# Hard ceiling on spend per user per calendar month, in US dollars, enforced
# in the database before every call (migration 0010). Unset: $2
# (slice-4-plan.md, decision C). Raise it here and in Vercel when needed.
LLM_MONTHLY_CAP_USD=2

# Small model for extraction and summaries; unset: gpt-5.6-luna. Must be one
# priced in lib/ai/models.ts. LLM_MODEL_GOOD is for drafting, in slice 5.
LLM_MODEL_FAST=
LLM_MODEL_GOOD=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# How far back the first Gmail sync reaches, in days. Start small while
# developing — a full backfill over years of mail is slow and costs money.
# 90 days: slice-1-plan.md, decision 1.
SYNC_DEFAULT_LOOKBACK_DAYS=90

# Optional: a shared secret so only your cron job can call the sync endpoint.
CRON_SECRET=

# ── Payments: Stripe (slice 13) ──────────────────────────────────────────
# Test mode for everything but production: sk_test_... from the Stripe
# dashboard, Developers -> API keys. A live key (sk_live_) is refused anywhere
# but Vercel's production environment (lib/stripe/client.ts). Put the value
# in .env.local, never here: this file is committed.
STRIPE_SECRET_KEY=
# Signs Stripe's calls to /api/stripe/webhook. Locally: printed by
# `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=
