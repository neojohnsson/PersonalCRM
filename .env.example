# Copy this file to .env.local and fill in the values.
# .env.local is gitignored. This file is committed — never put real secrets here.
#
# Rule to remember: NEXT_PUBLIC_ means the value is compiled into the browser
# bundle and is readable by anyone who opens devtools. Everything without that
# prefix stays on the server. Getting this wrong is the most common way people
# leak keys in a Next.js project.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Safe in the browser: the anon key is designed to be public and is useless
# without row-level security policies. Which means your RLS policies ARE your
# security. Write them first, test them, don't skip them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. This key bypasses every row-level security policy you wrote.
# Never prefix it with NEXT_PUBLIC_. Never import it into a client component.
# If it leaks, every user's contacts leak with it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Google OAuth (Gmail)
# ---------------------------------------------------------------------------
# From the Google Cloud console, APIs & Services > Credentials.
# The redirect URI must match what's registered there exactly, including the
# trailing path and the port. A mismatch is the #1 OAuth error.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ---------------------------------------------------------------------------
# Token encryption
# ---------------------------------------------------------------------------
# Gmail refresh tokens are stored in the database. A refresh token is a
# long-lived key to someone's mailbox, so encrypt it at rest rather than
# storing it in plain text.
# Generate with:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Hard ceiling on spend, enforced in code before every call. Set this on day
# one, not after the first surprise bill. A runaway sync loop over a large
# mailbox is a real and expensive failure mode.
LLM_MONTHLY_CAP_USD=25

# Small model for extraction and classification, larger one for drafting.
LLM_MODEL_FAST=
LLM_MODEL_GOOD=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# How far back the first Gmail sync reaches. Start small while developing —
# a full backfill over years of mail is slow and costs money.
SYNC_DEFAULT_LOOKBACK_MONTHS=12

# Optional: a shared secret so only your cron job can call the sync endpoint.
CRON_SECRET=
